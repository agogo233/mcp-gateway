{
  "listen": ":9200",
  "probeIntervalMs": 15000,
  "maxProbeIntervalMs": 300000,
  "autoDisableAfter": 10,
  "connectTimeoutMs": 3000,
  "listTimeoutMs": 3000,
  "syncBudgetMs": 30000,
  "failureThreshold": 2,
  "shutdownTimeoutMs": 5000,
  "aggregate": "all",
  "watchConfig": true,
  "auth": {
    "tokens": [
      "<openssl-rand-hex-32>",
      {"name": "opencode", "token": "<second-openssl-rand-hex-32>"}
    ]
  },
  "console": {
    "tokens": ["<third-openssl-rand-hex-32>"]
  },
  "authRateLimit": {
    "windowMs": 60000,
    "maxFails": 10,
    "blockMs": 60000
  },
  "upstreams": [
    {
      "name": "ida",
      "url": "http://192.0.2.10:8737/mcp",
      "callTimeoutMs": 60000
    },
    {
      "name": "x64dbg",
      "url": "http://192.0.2.20:9094/",
      "callTimeoutMs": 300000,
      "headers": {
        "Authorization": "Bearer <token>"
      }
    },
    {
      "name": "github",
      "url": "http://github-mcp:8080/mcp",
      "callTimeoutMs": 1900000,
      "probeIntervalMs": 60000,
      "headers": {
        "Authorization": "Bearer <github-mcp-auth-token>",
        "X-Client-Name": "mcp-gateway"
      }
    }
  ]
}
