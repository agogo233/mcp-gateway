# GitHub 个人访问令牌（细粒度推荐）——必填
GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_xxx

# go-github-mcp 的共享密钥（HTTP 模式必填）——部署时自动生成，勿用示例值
GITHUB_MCP_AUTH_TOKEN=change-me-openssl-rand-hex-32

# 工具集：default（context/users/repos/issues/pull_requests）或 all（77 个）
GITHUB_TOOLSETS=default

# true = 禁用全部写工具
GITHUB_MCP_READ_ONLY=false

# 控制台/MCP 监听暴露地址：127.0.0.1=仅宿主机本机；0.0.0.0=局域网（建议配防火墙限源）
MCP_GATEWAY_ADDR=127.0.0.1
